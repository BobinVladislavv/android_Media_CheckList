<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="20dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/appTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/app_name_Title"
        android:textAppearance="@style/TextAppearance.MediaCheckList.ScreenTitle"
        android:textSize="32sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:paddingBottom="20dp"
        android:textAlignment="center"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/movieButton"
        style="@style/Widget.MediaCheckList.Button.Menu"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:text="@string/movieButton_text"
        android:gravity="start|center_vertical"
        android:paddingStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/appTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/gamesButton"
        style="@style/Widget.MediaCheckList.Button.Menu"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:text="@string/gamesButton_text"
        android:gravity="start|center_vertical"
        android:paddingStart="24dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/movieButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/booksButton"
        style="@style/Widget.MediaCheckList.Button.Menu"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:text="@string/booksButton_text"
        android:gravity="start|center_vertical"
        android:paddingStart="24dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/gamesButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/statsTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/booksButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>