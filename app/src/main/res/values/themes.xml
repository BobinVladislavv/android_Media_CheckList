<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.MediaCheckList" parent="Theme.Material3.Light.NoActionBar">

        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_light</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorSurface">@color/surface</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>

        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorOnSecondary">@color/text_on_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>

        <item name="android:windowAnimationStyle">@style/WindowAnimation</item>

        <!-- Единые скругления -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.MediaCheckList.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MediaCheckList.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.MediaCheckList.Large</item>
    </style>

    <style name="ShapeAppearance.MediaCheckList.Small" parent="ShapeAppearance.Material3.Corner.Small"/>
    <style name="ShapeAppearance.MediaCheckList.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.MediaCheckList.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Заголовок экрана -->
    <style name="TextAppearance.MediaCheckList.ScreenTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Основная кнопка -->
    <style name="Widget.MediaCheckList.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/text_button</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Вторичная кнопка (для карточек меню) -->
    <style name="Widget.MediaCheckList.Button.Menu" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:elevation">2dp</item>
        <item name="rippleColor">@color/surface_variant</item>
    </style>

    <!-- Стиль кнопок в диалоге -->
    <style name="ThemeOverlay.MediaCheckList.Buttons" parent="">
        <item name="android:textColor">@color/text_button</item>
        <item name="fontFamily">@font/exotic350_font</item>
        <item name="colorPrimary">@color/dark_purple</item>
        <item name="colorOnPrimary">@color/text_button</item>
    </style>

    <style name="WindowAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_left</item>
    </style>

    <style name="Theme.MediaCheckList" parent="Base.Theme.MediaCheckList" />
</resources>